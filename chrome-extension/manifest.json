{
  "manifest_version": 3,
  "name": "Meet Leads Capture",
  "version": "0.1.0",
  "description": "Captura audio da aba do Google Meet e envia para processamento",
  "permissions": ["tabCapture", "storage", "activeTab"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.github.io/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Meet Leads" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["meet-content.js"]
    },
    {
      "matches": ["https://*.github.io/*", "http://127.0.0.1:5500/*"],
      "js": ["panel-bridge.js"]
    }
  ]
}
